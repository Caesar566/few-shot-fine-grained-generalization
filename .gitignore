__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
/.pytest_tmp/
.ipynb_checkpoints/

# Virtual environments
.venv/

# Machine-local tools and server transfer snapshots / archives
/.agents/
/.codex/
/.aws/
/server_transfer/

# Local datasets; versioned split manifests live in data/splits/
/cub2002011/
/data/raw/
/data/processed/
/data/cache/
/data/NABirds/
/nabirds/
