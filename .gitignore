# Experiment outputs are versioned under outputs/; legacy output/ is ignored
/output/

# Keep reports, statistics, curves and provenance; store model binaries separately
*.pth
*.pt
*.ckpt
*.onnx
*.safetensors
events.out.tfevents.*
/outputs/**/logs/tensorboard/
/outputs/**/local_torch_cache/

# Generated test fixtures and temporary checkpoints (including nested audit runs)
pytest_tmp/
/outputs/**/*_tmp/
*.tmp
*.before_no_git_fix

# Local IDE
.idea/

# report files
reports/
